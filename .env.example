PORT=5000
DATABASE_URL=postgres://user:password@ep-sample-12345.us-east-2.aws.neon.tech/neondb?sslmode=require
JWT_SECRET=your_jwt_secret_key_here
NODE_ENV=production

# Optional: URL of the OLD server that still holds files uploaded before Cloudinary (example: https://old-api.example.com).
# Missing /uploads/... files are redirected there so old images keep showing. Must NOT be this server.
LEGACY_UPLOADS_URL=
# Production safety switch: set to true on Render so a server missing the Cloudinary keys can never
# store big base64 files in the database (uploads are refused instead).
BLOCK_BASE64_STORAGE=false
# When an image/video/document is replaced or its record is deleted, the old file is also deleted from
# Cloudinary (only files in the lms/ folder that no row uses any more). Set to false to turn this off.
CLOUDINARY_AUTO_DELETE=true

# ── Transactional email (welcome email with login details) ──
# Brevo API key: https://app.brevo.com/settings/keys/api  (Brevo -> Security -> Authorised IPs must NOT block your server)
BREVO_API_KEY=
# Sender shown in the inbox. The address MUST be a verified sender / authenticated domain in Brevo.
EMAIL_FROM="Ravishing Art Hub <hello@your-verified-domain.com>"
# Public website URL used for the login link and logo in emails
FRONTEND_URL=https://ravishingarthub.com

# Free file storage (cloudinary.com). When set, images/PDFs/videos are uploaded there instead of the database or server disk.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
